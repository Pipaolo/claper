<div class="claper-join-page min-h-screen">
  <div
    x-data="{open: false}"
    id="menu"
    class="claper-join-menu w-full py-4 px-5 md:px-8 relative z-20"
    phx-update="ignore"
  >
    <div class="flex items-center justify-between max-w-6xl mx-auto">
      <ClaperWeb.BrandComponents.logo class="h-10 w-auto" />

      <div
        x-show="open"
        x-transition
        class="claper-join-menu-overlay fixed inset-0 z-50 flex flex-col items-center justify-center space-y-6 md:hidden"
        @click.away="open = false"
      >
        <button
          @click="open = false"
          class="absolute top-6 right-6"
          aria-label={gettext("Close menu")}
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            >
            </path>
          </svg>
        </button>
        <a
          href="https://paolotolentino.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-lg font-semibold transition-colors"
        >
          {gettext("About")}
        </a>
        <%= if @current_user do %>
          <.link href={~p"/events"} class="btn btn-primary btn-lg">
            {gettext("Dashboard")}
          </.link>
        <% else %>
          <.link href={~p"/users/log_in"} class="btn btn-primary btn-lg">
            {gettext("Log in")}
          </.link>
        <% end %>
      </div>

      <button
        @click="open = true"
        class="claper-join-menu-toggle p-2 md:hidden"
        aria-label={gettext("Open menu")}
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          >
          </path>
        </svg>
      </button>

      <div class="hidden md:flex items-center gap-6">
        <a
          href="https://paolotolentino.com"
          target="_blank"
          rel="noopener noreferrer"
          class="claper-join-link text-sm font-medium transition-colors"
        >
          {gettext("About")}
        </a>
        <%= if @current_user do %>
          <.link href={~p"/events"} class="btn btn-primary">
            {gettext("Dashboard")}
          </.link>
        <% else %>
          <.link href={~p"/users/log_in"} class="btn btn-primary">
            {gettext("Log in")}
          </.link>
        <% end %>
      </div>
    </div>
  </div>

  <div class="relative z-10 flex flex-col justify-center px-5 pb-14 pt-10 md:px-8 md:pb-20 md:pt-16">
    <div class="mx-auto w-full max-w-xl text-center">
      <div class="mb-14 md:mb-16">
        <h1 class="text-4xl font-bold text-[#F4F6FB] font-display md:text-5xl">
          {gettext("Join the event")}
        </h1>
        <p class="mx-auto mt-4 max-w-md text-base text-[#C5CDDC] md:text-lg">
          {gettext("Enter the code shared by the presenter")}
        </p>
      </div>

      <%= form_for :event, ~p"/join", ["phx-submit": "join", id: "form", class: "mx-auto max-w-lg"], fn f -> %>
        <div>
          <div class="mt-5 flex items-center gap-3 md:gap-4">
            <span class="text-2xl font-semibold text-[#C5CDDC] md:text-4xl">#</span>
            {text_input(f, :code,
              required: true,
              autofocus: true,
              maxlength: 10,
              placeholder: "ABCD1234",
              id: "input",
              "aria-invalid": to_string(not is_nil(@join_error)),
              "aria-describedby": if(@join_error, do: "join-code-error"),
              class:
                "join-code-input w-full px-3 py-4 text-center text-xl font-bold uppercase tracking-[0.15em] sm:text-2xl sm:tracking-[0.2em] md:px-4 md:text-5xl md:tracking-[0.28em]"
            )}
          </div>
          <p
            :if={@join_error}
            id="join-code-error"
            role="alert"
            class="mt-4 flex items-center justify-center gap-2 text-sm font-semibold text-[#F0A4AA]"
          >
            <svg
              aria-hidden="true"
              class="size-5 shrink-0"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM9 7a1 1 0 0 1 2 0v3a1 1 0 1 1-2 0V7Zm1 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{@join_error}</span>
          </p>
        </div>

        <div class="mt-10 flex justify-center">
          <button
            type="submit"
            id="submit"
            phx-disable-with={gettext("Join")}
            class="btn btn-primary btn-lg min-w-44 px-10 shadow-none"
          >
            {gettext("Join")}
          </button>
        </div>

        <%= if @last_event do %>
          <div class="mt-10 border-t border-[#4B5878] pt-6">
            <p class="text-sm text-[#C5CDDC]">{gettext("Return to your last event")}</p>
            <.link
              href={~p"/e/#{@last_event.code}"}
              class="claper-join-link mt-2 inline-flex items-center gap-2 text-base font-medium transition-colors"
            >
              <span>{@last_event.name}</span>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 7l-10 10M8 7h9v9"
                >
                </path>
              </svg>
            </.link>
          </div>
        <% end %>
      <% end %>

      <div class="mt-16 text-sm text-[#C5CDDC]">
        <span>{gettext("Are you a presenter?")}</span>
        <.link
          href={~p"/users/register"}
          class="claper-join-link ml-2 font-medium transition-colors"
        >
          {gettext("Start creating")}
        </.link>
      </div>
    </div>
  </div>
</div>
