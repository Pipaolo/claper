<!DOCTYPE html>
<html lang="en" data-theme="claper">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {csrf_meta_tag()}
    <.live_title suffix={" · #{gettext("Claper Admin")}"}>
      {assigns[:page_title] || "Admin Dashboard"}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={static_path(ClaperWeb.Endpoint, "/assets/app.css")}
    />
    <link
      phx-track-static
      rel="stylesheet"
      href={static_path(ClaperWeb.Endpoint, "/assets/admin.css")}
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={static_path(ClaperWeb.Endpoint, "/assets/app.js")}
    >
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
