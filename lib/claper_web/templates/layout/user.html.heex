<!DOCTYPE html>
<html lang={@current_user.locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {csrf_meta_tag()}
    <.live_title suffix={if assigns[:page_title], do: " · #{gettext("Claper")}", else: ""}>
      {assigns[:page_title] || gettext("Claper")}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={static_path(ClaperWeb.Endpoint, "/assets/app.css")}
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      phx-track-static
      rel="stylesheet"
      href={static_path(ClaperWeb.Endpoint, "/assets/custom.css")}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={static_path(ClaperWeb.Endpoint, "/assets/app.js")}
    >
    </script>
  </head>
  <body>
    <div class="min-h-full">
      <!-- Main column -->
      <div class="flex flex-col" x-data="{profileMobileDropdown: false}">
        {render("_profile_dropdown.html", user: @current_user, conn: @conn)}
        <main class="flex-1">
          {@inner_content}
        </main>
      </div>
    </div>
  </body>
</html>
