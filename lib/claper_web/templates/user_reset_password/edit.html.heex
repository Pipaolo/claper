<div>
  <div class="relative min-h-screen grid bg-black">
    <div class="flex min-h-screen flex-col md:flex-row items-stretch">
      <div class="claper-auth-backdrop hidden md:flex md:w-1/2 xl:w-3/5 flex-auto items-end justify-start overflow-hidden bg-cover bg-center p-10 text-white relative">
        <div class="absolute inset-0 bg-gradient-to-br from-black via-black/55 to-primary-900/70">
        </div>
        <div class="relative z-10 max-w-2xl space-y-8">
          <ClaperWeb.BrandComponents.logo class="w-auto h-16 lg:h-20" />

          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-200">
              {gettext("Almost there")}
            </p>
            <h1 class="text-4xl font-bold leading-tight text-white lg:text-6xl">
              {gettext("Pick a new password and get back to presenting.")}
            </h1>
            <p class="max-w-xl text-lg leading-8 text-gray-100/90 lg:text-xl">
              {gettext("Choose something secure that you'll remember, then you're all set.")}
            </p>
          </div>
        </div>
      </div>

      <div class="flex w-full items-center justify-center p-8 md:w-1/2 md:p-10 lg:p-14 xl:w-2/5">
        <div class="w-full max-w-xl">
          <div class="space-y-6">
            <div class="text-center md:text-left">
              <a href="/" class="inline-flex items-center">
                <ClaperWeb.BrandComponents.logo class="h-10 w-auto" />
              </a>

              <p class="mt-8 text-sm font-semibold uppercase tracking-[0.3em] text-primary-300">
                {gettext("Reset password")}
              </p>
              <h2 class="mt-4 text-4xl font-bold text-white lg:text-5xl">
                {gettext("Choose your new password")}
              </h2>
              <p class="mt-4 text-base leading-7 text-gray-300">
                {gettext("Set a new password below, then use it the next time you log in.")}
              </p>
            </div>

            <.form
              :let={f}
              for={@changeset}
              action={~p"/users/reset_password/#{@token}"}
              method="post"
              class="space-y-5"
            >
              <%= if @changeset.action do %>
                <ClaperWeb.Component.Alert.error
                  message={gettext("Oops, check that all fields are filled in correctly.")}
                  stick={true}
                />
              <% end %>

              <div class="space-y-2">
                <ClaperWeb.Component.Input.password
                  form={f}
                  key={:password}
                  labelClass="text-white"
                  fieldClass="bg-gray-900/80 text-white border border-white/10"
                  name={gettext("Password")}
                  placeholder={gettext("At least 6 characters")}
                  required="true"
                />

                <p class="text-sm text-gray-400">
                  {gettext("Use at least 6 characters so your account is ready to go.")}
                </p>
              </div>

              <ClaperWeb.Component.Input.password
                form={f}
                key={:password_confirmation}
                labelClass="text-white"
                fieldClass="bg-gray-900/80 text-white border border-white/10"
                name={gettext("Password confirmation")}
                placeholder={gettext("Repeat your new password")}
                required="true"
              />

              <div class="pt-3">
                <button type="submit" class="btn btn-primary w-full">
                  {gettext("Confirm new password")}
                </button>
              </div>
            </.form>

            <div class="text-center md:text-left">
              <ClaperWeb.BrandComponents.attribution class="text-xs text-gray-400 transition hover:text-white" />
            </div>

            <div class="space-y-4 border-t border-white/10 pt-6 text-center md:text-left">
              <p class="text-sm text-gray-300">
                {link(gettext("Back to log in"),
                  to: ~p"/users/log_in",
                  class: "font-semibold text-primary-300 transition hover:text-primary-200"
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
